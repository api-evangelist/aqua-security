{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aqua Security REST Authentication Users API",
    "version": "2022.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Aqua Security List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.cloud.aquasec.com/api/v1/users",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all users configured in the Aqua platform."
        }
      ]
    }
  ],
  "bundled": true
}