{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aqua Security REST Authentication Registries API",
    "version": "2022.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Registries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Aqua Security List Registries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.cloud.aquasec.com/api/v1/registries",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all configured container registries."
        }
      ]
    }
  ],
  "bundled": true
}